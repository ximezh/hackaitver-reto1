# HTTPS automático para producción y staging. La cámara del teléfono solo funciona con HTTPS (A-13).
# El front de cada entorno ya reenvía /api a su back (front/nginx.conf.template).

{$DOMINIO} {
	encode zstd gzip
	reverse_proxy front-produccion:80
}

staging.{$DOMINIO} {
	encode zstd gzip
	reverse_proxy front-staging:80
}
