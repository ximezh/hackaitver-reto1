# Staging (se publica desde `dev`, DO-13).
# En la instancia se copia como `entornos/staging.env`. Los valores reales no se versionan.
ENTORNO=staging

# Imágenes: las define el despliegue (DO-13) con la versión que se publica.
IMAGEN_BACK=ghcr.io/ximezh/hackaitver-reto1-back:staging
IMAGEN_FRONT=ghcr.io/ximezh/hackaitver-reto1-front:staging

# Base del entorno, distinta de la de producción. La contraseña se repite en DATABASE_URL.
POSTGRES_PASSWORD=<contraseña-larga>

# Back
APP_ENV=production
DATABASE_URL=postgresql://reto1:<contraseña-larga>@db:5432/reto1

# Nginx sirve el front y /api en el mismo dominio, así que el navegador no necesita CORS.
CORS_ORIGINS=["https://staging.<dominio>"]
