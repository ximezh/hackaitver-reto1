# Variables del back en staging (se publica desde `dev`, DO-13).
# Copia este archivo a la instancia como `staging.env`. Los valores reales no se versionan.
APP_ENV=production
DATABASE_URL=postgresql://reto1:<contraseña>@db-staging:5432/reto1_staging

# Nginx sirve el front y /api en el mismo dominio, así que el navegador no necesita CORS.
# Se deja solo el dominio propio para que ningún otro origen pueda llamar a la API.
CORS_ORIGINS=["https://staging.<dominio>"]
