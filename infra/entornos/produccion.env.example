# Variables del back en producción (se publica desde `main`, DO-13).
# Copia este archivo a la instancia como `produccion.env`. Los valores reales no se versionan.
APP_ENV=production
DATABASE_URL=postgresql://reto1:<contraseña>@db:5432/reto1

# Nginx sirve el front y /api en el mismo dominio, así que el navegador no necesita CORS.
# Se deja solo el dominio propio para que ningún otro origen pueda llamar a la API.
CORS_ORIGINS=["https://<dominio>"]
