# Producción (se publica desde `main`, DO-13).
# En la instancia se copia como `entornos/produccion.env`. Los valores reales no se versionan.
ENTORNO=produccion

# Puerto local del front; el Caddy del sistema lo publica en https://cedis.13-184-89-164.sslip.io
PUERTO_FRONT=8180

# Imágenes: las define el despliegue (DO-13) con la versión que se publica.
IMAGEN_BACK=ghcr.io/ximezh/hackaitver-reto1-back:produccion
IMAGEN_FRONT=ghcr.io/ximezh/hackaitver-reto1-front:produccion

# Base del entorno. La contraseña se repite en DATABASE_URL.
POSTGRES_PASSWORD=<contraseña-larga>

# Back
APP_ENV=production
# Firma de las sesiones (issue #8). Obligatoria con APP_ENV=production, de al menos 32 caracteres
# y distinta en cada entorno. Al cambiarla se cierran todas las sesiones del entorno.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<secreto-de-48-caracteres>
DATABASE_URL=postgresql://reto1:<contraseña-larga>@db:5432/reto1

# Nginx sirve el front y /api en el mismo dominio, así que el navegador no necesita CORS.
# Se deja solo el dominio propio para que ningún otro origen pueda llamar a la API.
CORS_ORIGINS=["https://cedis.13-184-89-164.sslip.io"]
