APP_ENV=development
# Coincide con compose.yaml de la raíz.
DATABASE_URL=postgresql://reto1:reto1@localhost:5432/reto1
# Base exclusiva de pytest. Debe ser distinta de DATABASE_URL: las pruebas la migran y escriben en ella.
TEST_DATABASE_URL=postgresql://reto1:reto1@localhost:5432/reto1_test
CORS_ORIGINS=["http://localhost:5173"]
# Firma de los tokens de sesión. Opcional en desarrollo; en producción es obligatoria (32+ caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
