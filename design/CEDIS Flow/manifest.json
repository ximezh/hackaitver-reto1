  "libraries": [],
  "components": [
    {
      "name": "Bulto",
      "group": "CEDIS · Android",
      "summary": "Detalle visual de un bulto: primero la imagen, luego su contenido; «Ver más» abre el desglose completo y la etiqueta QR."
    },
    {
      "name": "Caseta",
      "group": "CEDIS · Android",
      "summary": "Caseta: andenes ocupados de un vistazo, citas del día y registro de entrada y salida de camiones."
    },
    {
      "name": "Desembarque",
      "group": "CEDIS · Android",
      "summary": "Supervisor de desembarque: escanea cada bulto contra la OC y ve al momento lo recibido, lo faltante y lo rechazado."
    },
    {
      "name": "Elementos",
      "group": "Fundamentos",
      "summary": "Piezas base: botones, chips de estado, campos, segmentado, barras de avance y los colores de la tarima."
    },
    {
      "name": "Embarque",
      "group": "CEDIS · Android",
      "summary": "Supervisor de embarque: verifica que las tarimas almacenadas sean las que salen, llena el tortón y genera la Relación de Embarque."
    },
    {
      "name": "Flujo",
      "group": "Fundamentos",
      "summary": "Mapa interactivo del proceso Sucursal → CEDIS → Proveedor y de vuelta, con la pantalla que cubre cada paso."
    },
    {
      "name": "LoginMovil",
      "group": "Acceso",
      "summary": "Inicio de sesión Android para el CEDIS; detecta el rol por el usuario y abre solo sus módulos."
    },
    {
      "name": "LoginWeb",
      "group": "Acceso",
      "summary": "Inicio de sesión web para Sucursal, Proveedor y Oficina, con la ilustración del rol elegido."
    },
    {
      "name": "Oficina",
      "group": "Web",
      "summary": "Oficina: CRUD de productos, proveedores, sucursales y usuarios, con indicadores del día y ocupación de los 32 racks."
    },
    {
      "name": "Proveedor",
      "group": "Web",
      "summary": "Portal web del proveedor: agenda la cita por andén, captura la factura desglosada por bulto, descarga etiquetas QR y consulta su historial."
    },
    {
      "name": "Sucursal",
      "group": "Web",
      "summary": "Portal web de sucursal: pide por bultos con imágenes, sigue cada pedido paso a paso y recibe con el QR de la relación."
    },
    {
      "name": "Tarima3D",
      "group": "CEDIS · Android",
      "summary": "Tarima virtual en 3D que se gira con el dedo y acomoda los bultos por peso en tres cajas: roja abajo, naranja en medio, verde arriba."
    }
  ],
